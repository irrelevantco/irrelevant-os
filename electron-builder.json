{
  "appId": "co.irrelevant.os",
  "productName": "iRRELEVANT OS",
  "electronVersion": "45.3.4",
  "asar": false,
  "directories": {
    "app": "desktop",
    "output": "work/windows-installer",
    "buildResources": "public"
  },
  "artifactName": "iRRELEVANT-OS-Setup-${version}.${ext}",
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "public/brand-ir.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "publish": [
    {
      "provider": "github",
      "owner": "irrelevantco",
      "repo": "irrelevant-os",
      "releaseType": "prerelease"
    }
  ]
}
