# Phase 1: copy to .env.local for a hosted Supabase project or standard CLI stack.
# Or use `npm run local:env` to generate credentials for the lightweight LOCAL stack.
APP_URL=http://localhost:3030
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable key (or legacy anon JWT); never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
# Must be true and URL must be loopback for integration/e2e tests to create test accounts.
ALLOW_LOCAL_INTEGRATION_TESTS=false

# Google is optional and server-only. Sending stays disabled until connected and approved.
# Keep all credentials below SERVER ONLY. Leave unset until their phase is built.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3030/api/integrations/google/callback
# AES-256-GCM key: 32 random bytes encoded as base64; persist privately across deploys.
OAUTH_TOKEN_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AI_PROVIDER=template
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MONTHLY_BUDGET_USD=0
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
OUTREACH_DAILY_LIMIT=0
SENDER_POSTAL_ADDRESS=

# Hosted private operator access. REQUIRED in production; comma-separated exact emails.
OPERATOR_EMAIL_ALLOWLIST=
# Company discovery only. Optional; no request occurs without owner approval and a credit allowance.
EXPLEE_API_KEY=

# Optional server runtime aliases (used by the personal desktop package).
# These override the NEXT_PUBLIC Supabase connection on the server. Never use service-role keys.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
